{
  "name": "firebase-vault-starter",
  "version": "0.1.0",
  "private": true,
  "description": "A small, tested Firebase login-and-database starter for people building with Claude.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node --no-deprecation scripts/setup.mjs",
    "dev": "firebase emulators:exec --project demo-vault --only auth,firestore --ui \"vite\"",
    "test:rules": "firebase emulators:exec --project demo-vault --only firestore \"vitest run --reporter=verbose\"",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && firebase deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.31.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
