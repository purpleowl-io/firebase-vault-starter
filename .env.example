# Copy this file to .env.local and fill it in (npm run setup does this for you).
# These values identify your Firebase project. They are not secrets: your
# security rules are what protect the data. See docs/SECURITY.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Development always uses the local emulators. Set this to true to also use
# them in a production build (for example when running `npm run preview`).
VITE_USE_EMULATORS=
